#!/bin/sh
# exe-dev — Harvester's default machine provider (docs/PROVIDERS.md).
#
# A field-renaming wrapper over exe.dev's SSH control plane, implemented in the
# same format as user providers: one exec per operation, args as one JSON
# object on stdin, result as one JSON object on stdout, diagnostics on stderr.
# It doubles as the contract's living documentation.
#
# Auth rides the user's existing exe.dev SSH key; nothing is stored here.
set -eu

# BatchMode: providers must never prompt (stdin is closed after the args object).
EXE_SSH="ssh -o BatchMode=yes -o ConnectTimeout=10 exe.dev"

# Reaching a *freshly created* VM needs accept-new: its host key has never been
# seen, and BatchMode alone hard-fails on an unknown key. Still hard-fails if a
# known key changes (exe.dev's fleet shares one key, so this is first contact
# only). Used for the VM itself, never for the control plane.
VM_SSH="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"

# Maps one exe.dev vm object to a Harvester machine object. `status` is
# advisory by contract — the UI dot comes from Harvester's own SSH probe.
MACHINE_JQ='{
  id: .vm_name,
  label: .vm_name,
  status: (if .status == "running" or .status == "stopped" then .status else "unknown" end),
  ssh: {host: .ssh_dest, user: "exedev"}
}'

require_jq() {
    if command -v jq >/dev/null 2>&1; then
        return 0
    fi

    echo '{"error": "the exe-dev provider needs jq (https://jqlang.org) on PATH"}'
    exit 1
}

# Machine ids travel into a remote shell command line; refuse anything that
# is not a plain exe.dev vm name rather than trying to quote it.
require_safe_name() {
    require_safe_value "machine name" "$1"
}

# The gate itself: every value that reaches the remote command line goes
# through it, not just names (`--cpu`/`--memory` travel exactly as far).
require_safe_value() {
    case "$2" in
    *[!A-Za-z0-9-]* | "")
        printf '{"error": "invalid %s: %s"}\n' "$1" "$2" >&2
        printf '{"error": "invalid %s"}\n' "$1"
        exit 1
        ;;
    esac
}

# `set -e` cannot see a failure at the HEAD of a pipeline (POSIX sh has no
# pipefail), so a down control plane would exit 0 with empty stdout and
# Harvester would blame this script for invalid JSON. Capture first (into
# `$out` — POSIX sh has no locals either), then transform.
exe_ssh_capture() {
    if ! out=$($EXE_SSH "$@"); then
        printf '{"error": "exe.dev control plane unreachable (ssh %s failed)"}\n' "$1"
        exit 1
    fi
}

# Turns on the VM image's keyless LLM gateway (docs/SPEC.md §Auth & model
# routing): the bundled pi extension only registers the gateway's models when
# ~/.pi/agent/exe-dev-llm-integration.json says so — otherwise it pops a
# startup `select` dialog and, unanswered, silently skips the integration.
#
# It lives here rather than in harvesterd's bootstrap because only this
# provider knows the machine is an exe.dev VM; the bootstrap's start script
# also runs for the `local` machine, where writing into the user's own ~/.pi
# would be a trespass.
#
# Advisory: a VM that is still booting is not a create failure, so a failed
# seed is a stderr diagnostic and nothing more. Idempotent and never
# destructive — an existing file is the user's, whatever it says.
seed_llm_integration() {
    if ! $VM_SSH "exedev@$1" sh -s >&2 <<'SEED_SCRIPT'
set -eu
seed=$HOME/.pi/agent/exe-dev-llm-integration.json

if [ -e "$seed" ]; then
    if ! grep -q '"useExeIntegration"[[:space:]]*:[[:space:]]*true' "$seed"; then
        echo "harvester: $seed exists and does not enable the exe.dev LLM integration; left as is" >&2
    fi

    exit 0
fi

mkdir -p "$(dirname "$seed")"
printf '%s\n' '{"version":1,"useExeIntegration":true}' > "$seed.harvester.$$"
mv "$seed.harvester.$$" "$seed"
SEED_SCRIPT
    then
        printf 'harvester: could not seed the exe.dev LLM integration on %s (still booting?); pi will ask about it at startup\n' "$1" >&2
    fi
}

case "${1:-}" in
info)
    cat <<'EOF'
{
  "protocol": 1,
  "name": "exe.dev",
  "capabilities": ["create", "delete"],
  "create_fields": [
    {"key": "name", "label": "Machine name", "type": "string", "required": true},
    {"key": "cpu", "label": "CPUs", "type": "number", "required": false},
    {"key": "memory", "label": "Memory (e.g. 8g)", "type": "string", "required": false}
  ]
}
EOF
    ;;

list)
    require_jq
    exe_ssh_capture ls --json
    printf '%s' "$out" | jq "{machines: [.vms[] | $MACHINE_JQ]}"
    ;;

create)
    require_jq
    args=$(cat)

    if ! name=$(printf '%s' "$args" | jq -er '.name'); then
        echo '{"error": "create: \"name\" is required"}'
        exit 1
    fi
    require_safe_name "$name"

    set -- new --json --name "$name"
    cpu=$(printf '%s' "$args" | jq -r '.cpu // empty')
    if [ -n "$cpu" ]; then
        require_safe_value "cpu" "$cpu"
        set -- "$@" --cpu "$cpu"
    fi
    memory=$(printf '%s' "$args" | jq -r '.memory // empty')
    if [ -n "$memory" ]; then
        require_safe_value "memory" "$memory"
        set -- "$@" --memory "$memory"
    fi

    # `new --json` returns the vm object (tolerate a {vm: ...} wrapper too).
    exe_ssh_capture "$@"
    machine=$(printf '%s' "$out" | jq "{machine: ((.vm // .) | $MACHINE_JQ)}")

    host=$(printf '%s' "$machine" | jq -r '.machine.ssh.host // empty')
    if [ -n "$host" ]; then
        seed_llm_integration "$host"
    fi

    printf '%s' "$machine"
    ;;

delete)
    require_jq

    if ! id=$(jq -er '.id'); then
        echo '{"error": "delete: \"id\" is required"}'
        exit 1
    fi
    require_safe_name "$id"

    # `rm` prints a plain-text confirmation — diagnostics, not a result.
    $EXE_SSH rm "$id" >&2
    echo '{}'
    ;;

*)
    printf '{"error": "unknown operation: %s"}\n' "${1:-<none>}"
    exit 1
    ;;
esac
